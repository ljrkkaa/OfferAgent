{
    "name": "offeragent-obsidian",
    "version": "2.0.0-beta.28",
    "description": "Interview prep and offer workflow assistant for Obsidian",
    "author": "OfferAgent",
    "license": "GPL-3.0-or-later",
    "main": "main.js",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "protocol:generate": "node scripts/generate-protocol-identity.mjs && node scripts/generate-protocol-types.mjs",
        "protocol:check": "node scripts/generate-protocol-identity.mjs --check && node scripts/generate-protocol-types.mjs --check",
        "typecheck": "npm run protocol:check && tsc -noEmit -skipLibCheck",
        "build:local": "npm run typecheck && node esbuild.config.mjs local-development",
        "test": "node --test tests/*.test.cjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "interview",
        "knowledge-base",
        "agent"
    ],
    "devDependencies": {
        "@types/node": "^16.11.6",
        "builtin-modules": "3.3.0",
        "esbuild": "0.14.47",
        "obsidian": "^1.6.6",
        "tslib": "2.4.0",
        "typescript": "4.7.4"
    },
    "resolutions": {
        "picomatch": ">=2.3.2"
    }
}
